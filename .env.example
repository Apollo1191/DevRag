# Copy this file to .env and replace values.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=1200
DEVRAG_EMBEDDING_PROVIDER=local
DEVRAG_CORS_ORIGINS=http://localhost:5173
DEVRAG_VECTOR_BACKEND=qdrant
DEVRAG_QDRANT_COLLECTION=devrag_chunks
DEVRAG_QDRANT_DIMENSION=384
DEVRAG_MIN_VECTOR_RELEVANCE=0.55
QDRANT_API_KEY=devrag
